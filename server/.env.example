# Ghosty server environment. Copy to .env and fill in what you need.
# Every key is optional: missing keys fall back to fake providers so `npm run dev` works day one.
# Never commit .env.

# --- HTTP -------------------------------------------------------------------
# Port the server listens on.
PORT=3000
# Bind address. 0.0.0.0 so the ESP32 on the same Wi-Fi can reach the laptop.
HOST=0.0.0.0
# Shared secret the device sends as `X-Device-Token`. Leave empty to skip the check (local dev only).
DEVICE_TOKEN=

# --- Speech (audio/) --------------------------------------------------------
# Groq API key for whisper-large-v3-turbo speech-to-text (console.groq.com).
GROQ_API_KEY=
# ElevenLabs API key for eleven_flash_v2_5 TTS with output_format=pcm_16000.
ELEVENLABS_API_KEY=

# --- 0G (agent/, safety/) ---------------------------------------------------
# 0G Compute Router, OpenAI-compatible. Testnet: https://router-api-testnet.integratenetwork.work/v1
# Mainnet: https://router-api.0g.ai/v1
OG_ROUTER_URL=https://router-api-testnet.integratenetwork.work/v1
# Router API key from pc.testnet.0g.ai (testnet) or pc.0g.ai (mainnet).
OG_API_KEY=
# EVM private key that pays for 0G Storage uploads (Galileo testnet, chain 16602). Fund at faucet.0g.ai.
OG_PRIVATE_KEY=
# 0G Storage indexer (testnet turbo).
OG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# --- Hedera x402 (payments/) ------------------------------------------------
# Agent wallet (the PAYER). Hedera testnet account id, e.g. 0.0.1234567 (portal.hedera.com).
# With both keys set, payments are real (x402Client.ts + HCS audit); without them the fake payer is used.
HEDERA_ACCOUNT_ID=
# Private key for HEDERA_ACCOUNT_ID: DER (302e…/3030…) or raw 32-byte hex (0x optional).
HEDERA_PRIVATE_KEY=
# Curve of a raw hex HEDERA_PRIVATE_KEY: ecdsa (portal default) or ed25519. Ignored for DER keys.
HEDERA_KEY_TYPE=ecdsa
# testnet or mainnet. The track only needs testnet.
HEDERA_NETWORK=testnet
# Optional: reuse an existing HCS audit topic. Otherwise one is created and cached in server/.ghosty/hcs.json.
HEDERA_HCS_TOPIC_ID=
# x402 facilitator that verifies and settles payments on hedera:testnet (no API key).
# Alternatives: https://testnet.facilitator.launa.dev, https://api.testnet.blocky402.com
X402_FACILITATOR_URL=https://x402.org/facilitator
# MERCHANT account that receives GET /signal payments. Must be a second testnet account, not
# HEDERA_ACCOUNT_ID (a self-transfer nets to zero and the agent refuses it). Defaults to HEDERA_ACCOUNT_ID.
X402_PAY_TO=
# Price of one GET /signal in tinybars (1 HBAR = 100000000). 1000000 = 0.01 HBAR.
X402_SIGNAL_PRICE_TINYBAR=1000000
# Agent spend controls: max tinybars per single payment, and per UTC day (persisted in server/.ghosty/spend.json).
X402_MAX_PER_CALL_TINYBAR=10000000
X402_MAX_SPEND_TINYBAR=100000000
# Comma-separated hosts (or host:port, or *.domain) the agent may pay. Anything else is refused before signing.
X402_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Hyperliquid (execution/) -----------------------------------------------
# Master account address. Account data is queried with this address.
HL_MASTER_ADDRESS=
# API (agent) wallet private key approved by the master via ApproveAgent. Never the master key.
HL_AGENT_PRIVATE_KEY=
# true = app.hyperliquid-testnet.xyz, false = mainnet (use tiny size).
HL_TESTNET=true

# --- Uniswap / EVM wallet (wallet/) -----------------------------------------
# Uniswap Trading API key (developers.uniswap.org), sent as `x-api-key`.
UNISWAP_API_KEY=
# Agent EVM private key used to sign Uniswap swaps.
EVM_PRIVATE_KEY=
# Public address of EVM_PRIVATE_KEY. Shown by the account stub until viem derives it.
EVM_ADDRESS=
# RPC for the swap chain, e.g. Base Sepolia https://sepolia.base.org
EVM_RPC_URL=

# --- News and credibility (news/, credibility/) -----------------------------
# CryptoPanic API token (free developer tier).
CRYPTOPANIC_TOKEN=
# Value for the `X-Ethos-Client` header on Ethos API v2 calls.
ETHOS_CLIENT=ghosty@0.1.0
# xAI API key for Grok x_search (live X posts). Optional, paid per post.
XAI_API_KEY=

# --- Safety and limits ------------------------------------------------------
# When true, /voice and /button return 503 brain_offline if 0G is unreachable (0G Physical AI requirement).
SAFE_STOP_ENABLED=true
# Stub switch: pretend 0G is unreachable to demo safe-stop. Replaced by a real router ping.
SIMULATE_BRAIN_OFFLINE=false
# Hard cap on total USD notional per decision across all legs.
MAX_TRADE_USD=25
