# Ghosty server environment. Copy to .env and fill in what you need.
# Every key is optional: missing keys fall back to fake providers so `npm run dev` works day one.
# Never commit .env.

# --- HTTP -------------------------------------------------------------------
# Port the server listens on.
PORT=3000
# Bind address. 0.0.0.0 so the ESP32 on the same Wi-Fi can reach the laptop.
HOST=0.0.0.0
# Shared secret the device sends as `X-Device-Token`. Leave empty to skip the check (local dev only).
DEVICE_TOKEN=

# --- Speech (audio/) --------------------------------------------------------
# Groq API key for whisper-large-v3-turbo speech-to-text (console.groq.com).
GROQ_API_KEY=
# ElevenLabs API key for eleven_flash_v2_5 TTS with output_format=pcm_16000.
ELEVENLABS_API_KEY=

# --- 0G (agent/, safety/) ---------------------------------------------------
# 0G Compute Router, OpenAI-compatible. Testnet: https://router-api-testnet.integratenetwork.work/v1
# Mainnet: https://router-api.0g.ai/v1
OG_ROUTER_URL=https://router-api-testnet.integratenetwork.work/v1
# Router API key from pc.testnet.0g.ai (testnet) or pc.0g.ai (mainnet).
OG_API_KEY=
# EVM private key that pays for 0G Storage uploads (Galileo testnet, chain 16602). Fund at faucet.0g.ai.
OG_PRIVATE_KEY=
# 0G Storage indexer (testnet turbo).
OG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# --- Hedera x402 (payments/) ------------------------------------------------
# Hedera testnet account id, e.g. 0.0.1234567 (portal.hedera.com).
HEDERA_ACCOUNT_ID=
# Private key for HEDERA_ACCOUNT_ID (DER or hex string).
HEDERA_PRIVATE_KEY=
# x402 facilitator that verifies and settles payments on hedera:testnet.
X402_FACILITATOR_URL=https://x402.org/facilitator

# --- Hyperliquid (execution/) -----------------------------------------------
# Real venue only when both HL_MASTER_ADDRESS and HL_AGENT_PRIVATE_KEY are set; otherwise the fake venue.
# Pre-event check: `npm run hl:check` (read-only, no keys needed).
# Master account address. Account data is queried with this address.
HL_MASTER_ADDRESS=
# API (agent) wallet private key approved by the master via ApproveAgent. Never the master key.
HL_AGENT_PRIVATE_KEY=
# true = app.hyperliquid-testnet.xyz, false = mainnet (use tiny size).
HL_TESTNET=true
# HIP-3 builder dexes to load besides the main dex (comma-separated). trade.xyz = xyz.
HL_DEXES=xyz
# Fallbacks when a HIP-3 market is missing, e.g. GOLD=BTC,WTI=ETH. Fallback orders are tagged `fallback: true`.
HL_FALLBACK_COINS=

# --- Uniswap / EVM wallet (wallet/) -----------------------------------------
# Uniswap Trading API key (developers.uniswap.org/dashboard), sent as `x-api-key`.
# Real swaps only when both UNISWAP_API_KEY and EVM_PRIVATE_KEY are set; otherwise a fake tx hash.
UNISWAP_API_KEY=
UNISWAP_API_URL=https://trade-api.gateway.uniswap.org/v1
# true = run the Uniswap spot leg before the perp legs on a confirmed trade.
UNISWAP_SPOT_LEG=false
# Demo pair (defaults: WETH → USDC on Base Sepolia). Verify liquidity the day before.
UNISWAP_DEMO_TOKEN_IN=0x4200000000000000000000000000000000000006
UNISWAP_DEMO_TOKEN_OUT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# tokenIn amount in base units (100000000000000 = 0.0001 WETH).
UNISWAP_DEMO_AMOUNT=100000000000000
# Max slippage in percent for the quote.
UNISWAP_SLIPPAGE_PCT=1
# Agent EVM private key that signs approvals, Permit2 messages and swaps. The address is derived from it.
EVM_PRIVATE_KEY=
# Optional watch-only address, used only when EVM_PRIVATE_KEY is empty.
EVM_ADDRESS=
# Chain for the swap. 84532 = Base Sepolia, 1301 = Unichain Sepolia, 11155111 = Sepolia.
EVM_CHAIN_ID=84532
# RPC for EVM_CHAIN_ID. Empty = the chain's public RPC (rate limited), e.g. https://sepolia.base.org
EVM_RPC_URL=

# --- News and credibility (news/, credibility/) -----------------------------
# CryptoPanic API token (free developer tier).
CRYPTOPANIC_TOKEN=
# Value for the `X-Ethos-Client` header on Ethos API v2 calls.
ETHOS_CLIENT=ghosty@0.1.0
# xAI API key for Grok x_search (live X posts). Optional, paid per post.
XAI_API_KEY=

# --- Safety and limits ------------------------------------------------------
# When true, /voice and /button return 503 brain_offline if 0G is unreachable (0G Physical AI requirement).
SAFE_STOP_ENABLED=true
# Stub switch: pretend 0G is unreachable to demo safe-stop. Replaced by a real router ping.
SIMULATE_BRAIN_OFFLINE=false
# Hard cap on total USD notional per decision across all legs.
MAX_TRADE_USD=25
