# Ghosty server environment. Copy to .env and fill in what you need.
# Live mode (default) uses real providers only: a provider without its keys answers 503 not_configured,
# and without OG_API_KEY every decision is a safe-stop. `npm run doctor` lists what is missing.
# Never commit .env.

# --- Mode --------------------------------------------------------------------
# live (default): real data only. test: offline fakes, set by `npm test`; do not use it for a demo.
GHOSTY_MODE=live

# --- HTTP -------------------------------------------------------------------
# Port the server listens on.
PORT=3000
# Bind address. 0.0.0.0 so the ESP32 on the same Wi-Fi can reach the laptop.
HOST=0.0.0.0
# Shared secret the device sends as `X-Device-Token`. Leave empty to skip the check (local dev only).
DEVICE_TOKEN=

# --- Speech (audio/) --------------------------------------------------------
# Groq API key for Whisper speech-to-text (console.groq.com/keys). Unset = fake STT.
GROQ_API_KEY=
# Groq transcription model: whisper-large-v3-turbo (fast, cheap) or whisper-large-v3.
GROQ_STT_MODEL=whisper-large-v3-turbo
# ElevenLabs API key (elevenlabs.io → Developers → API keys). Streams pcm_16000, no resampling. Unset = next fallback.
ELEVENLABS_API_KEY=
# Voice id. Default "George" from the ElevenLabs API docs; list yours with GET /v1/voices.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# TTS fallback when ELEVENLABS_API_KEY is unset: OpenAI gpt-4o-mini-tts (24 kHz PCM resampled to 16 kHz).
# Both unset = 440 Hz tone.
OPENAI_API_KEY=

# --- 0G (agent/, safety/) ---------------------------------------------------
# 0G Compute Router, OpenAI-compatible. Testnet: https://router-api-testnet.integratenetwork.work/v1
# Mainnet: https://router-api.0g.ai/v1
OG_ROUTER_URL=https://router-api-testnet.integratenetwork.work/v1
# Router API key from pc.testnet.0g.ai (testnet) or pc.0g.ai (mainnet).
OG_API_KEY=
# EVM private key that pays for 0G Storage uploads (Galileo testnet, chain 16602). Fund at faucet.0g.ai.
OG_PRIVATE_KEY=
# 0G Storage indexer (testnet turbo).
OG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
# Router model id. List: curl $OG_ROUTER_URL/models (no auth). Pick one whose supported_parameters has response_format.
OG_MODEL=glm-4.7
# Send response_format=json_object. Set false if the chosen model rejects structured output.
OG_JSON_MODE=true
# 0G Galileo EVM RPC (chain 16602) used for storage transactions.
OG_RPC_URL=https://evmrpc-testnet.0g.ai
# 64-hex-char AES-256-GCM key for user memory. Empty → derived as sha256 of OG_PRIVATE_KEY. Losing it loses the memory.
OG_MEMORY_KEY=
# true = upload episodes in batches of OG_EPISODE_BATCH_SIZE (one storage tx per batch) to save faucet gas.
OG_EPISODE_BATCH=false
OG_EPISODE_BATCH_SIZE=5
# Where root-hash pointers are cached (memory.json, episodes.jsonl). Empty → server/.ghosty
OG_DATA_DIR=

# --- Hedera x402 (payments/) ------------------------------------------------
# Accounts and keys explained in docs/hedera.md. Easiest path: fill the TREASURY + merchant lines, then run
# `npm run hedera:setup` (testnet only, idempotent): it creates the AGENT account, associates USDC, funds the
# agent, creates the HCS submit key and topic, and writes those keys below.
# TREASURY (cold, big balance). Only hedera:setup reads it; the server never does.
HEDERA_TREASURY_ACCOUNT_ID=
HEDERA_TREASURY_PRIVATE_KEY=
# AGENT hot wallet (the x402 PAYER, ~20 HBAR + ~5 USDC). Written by hedera:setup.
HEDERA_ACCOUNT_ID=
# Private key for HEDERA_ACCOUNT_ID: DER (302e…/3030…) or raw 32-byte hex (0x optional).
HEDERA_PRIVATE_KEY=
# Curve of a raw hex private key: ecdsa (portal default) or ed25519. Ignored for DER keys.
HEDERA_KEY_TYPE=ecdsa
# testnet or mainnet. The track only needs testnet.
HEDERA_NETWORK=testnet
# HCS audit topic and its submit key (holds no funds). Written by hedera:setup; the server never creates topics.
HEDERA_HCS_TOPIC_ID=
HEDERA_HCS_SUBMIT_KEY=
# Safety cap on audit messages per UTC day (~0.0008 HBAR each, paid by the agent).
HEDERA_HCS_MAX_MESSAGES_PER_DAY=500
# Signal Desk merchant key: used once by hedera:setup to associate the merchant with USDC.
HEDERA_MERCHANT_PRIVATE_KEY=
# Optional overrides: mirror node REST base, USDC token id (default testnet 0.0.429274).
HEDERA_MIRROR_URL=
HEDERA_USDC_TOKEN_ID=
# x402 facilitator that verifies and settles payments (no API key). Leave empty for Blocky402 on HEDERA_NETWORK:
# https://api.testnet.blocky402.com (testnet) or https://api.blocky402.com (mainnet).
# Alternatives: https://testnet.facilitator.launa.dev, https://www.x402.org/facilitator (testnet only; the bare
# x402.org host reset connections on 2026-11-06).
X402_FACILITATOR_URL=
# Before deciding on a shock headline, the agent buys the Signal Desk intel itself, with no human approval
# (Hedera track). Only while the brain is online. false = only the sim button pays.
X402_AUTOPAY=true
# Max time a decision waits for the purchase (ms) before deciding without it. A late purchase is still recorded.
X402_AUTOPAY_WAIT_MS=8000
# Signal Desk MERCHANT account (its own process: `npm run signal-desk`). Must differ from HEDERA_ACCOUNT_ID.
X402_PAY_TO=
SIGNAL_DESK_PORT=3101
# Where the agent buys intel. Default http://127.0.0.1:$SIGNAL_DESK_PORT. Add a remote host to X402_ALLOWED_HOSTS.
SIGNAL_DESK_URL=
# Intel prices: tinybars (1000000 = 0.01 HBAR) and USDC micro-units (10000 = 0.01 USDC).
X402_INTEL_PRICE_TINYBAR=1000000
X402_INTEL_PRICE_USDC_MICROS=10000
# Asset the agent pays with when the desk offers both: usdc or hbar.
X402_PREFERRED_ASSET=usdc
# Agent spend controls per asset: max per payment, and per UTC day (persisted in server/.ghosty/spend.json).
# Demo-day defaults: 0.1 HBAR / 0.1 USDC per call; 5 HBAR (500 buys) and 2 USDC (200 buys) per day.
X402_MAX_PER_CALL_TINYBAR=10000000
X402_MAX_PER_CALL_USDC_MICROS=100000
X402_MAX_SPEND_TINYBAR=500000000
X402_MAX_SPEND_USDC_MICROS=2000000
# Comma-separated hosts (or host:port, or *.domain) the agent may pay. Anything else is refused before signing.
X402_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Hyperliquid (execution/) -----------------------------------------------
# Real venue only when both HL_MASTER_ADDRESS and HL_AGENT_PRIVATE_KEY are set; otherwise the fake venue.
# Pre-event check: `npm run hl:check` (read-only, no keys needed).
# Master account address. Account data is queried with this address.
HL_MASTER_ADDRESS=
# API (agent) wallet private key approved by the master via ApproveAgent. Never the master key.
HL_AGENT_PRIVATE_KEY=
# true = app.hyperliquid-testnet.xyz, false = mainnet (use tiny size).
HL_TESTNET=true
# HIP-3 builder dexes to load besides the main dex (comma-separated). trade.xyz = xyz.
HL_DEXES=xyz
# Fallbacks when a HIP-3 market is missing, e.g. GOLD=BTC,WTI=ETH. Fallback orders are tagged `fallback: true`.
HL_FALLBACK_COINS=

# Simulation: also place REAL orders on Hyperliquid MAINNET when a sim trade is confirmed (per-run opt-in in the
# Simulate tab). Always mainnet, whatever HL_TESTNET says; needs a mainnet API wallet in the two HL_ keys above.
SIM_LIVE_ORDERS=false
# Notional per real leg (Hyperliquid minimum is $10) and the most one run may place in total.
SIM_LIVE_ORDER_USD=11
SIM_LIVE_MAX_RUN_USD=50

# --- Uniswap / EVM wallet (wallet/) -----------------------------------------
# Uniswap Trading API key (developers.uniswap.org/dashboard), sent as `x-api-key`.
# Real swaps only when both UNISWAP_API_KEY and EVM_PRIVATE_KEY are set; otherwise a fake tx hash.
UNISWAP_API_KEY=
UNISWAP_API_URL=https://trade-api.gateway.uniswap.org/v1
# true = run the Uniswap spot leg before the perp legs on a confirmed trade.
UNISWAP_SPOT_LEG=false
# Demo pair (defaults: WETH → USDC on Base Sepolia). Verify liquidity the day before.
UNISWAP_DEMO_TOKEN_IN=0x4200000000000000000000000000000000000006
UNISWAP_DEMO_TOKEN_OUT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# tokenIn amount in base units (100000000000000 = 0.0001 WETH).
UNISWAP_DEMO_AMOUNT=100000000000000
# Max slippage in percent for the quote.
UNISWAP_SLIPPAGE_PCT=1
# Agent EVM private key that signs approvals, Permit2 messages and swaps. The address is derived from it.
EVM_PRIVATE_KEY=
# Optional watch-only address, used only when EVM_PRIVATE_KEY is empty.
EVM_ADDRESS=
# Chain for the swap. 84532 = Base Sepolia, 1301 = Unichain Sepolia, 11155111 = Sepolia.
EVM_CHAIN_ID=84532
# RPC for EVM_CHAIN_ID. Empty = the chain's public RPC (rate limited), e.g. https://sepolia.base.org
EVM_RPC_URL=

# --- News and credibility (news/, credibility/) -----------------------------
# Poll the keyless real sources (4 RSS feeds + Polymarket). Default: true in live mode, false in test mode.
# Sources without a key are left out, never faked.
NEWS_LIVE=
# Comma-separated `name=url` or bare urls. Empty = CoinDesk, Cointelegraph, The Block, Decrypt.
NEWS_RSS_FEEDS=
# Polymarket: keep open markets whose event title or question starts a word with one of these.
NEWS_POLYMARKET_KEYWORDS=war,strike,ceasefire,invasion,sanction,missile,nuclear
# Optional Gamma tag_slug filter (e.g. geopolitics).
NEWS_POLYMARKET_TAG=
# Rolling window the aggregator keeps, poll interval, and per-provider deadline.
NEWS_WINDOW_MINUTES=120
NEWS_POLL_SECONDS=60
NEWS_PROVIDER_TIMEOUT_MS=8000
# Last-seen ids so restarts do not re-announce headlines (gitignored).
NEWS_SEEN_PATH=.ghosty/news-seen.json
# CryptoPanic API token (cryptopanic.com/developers/api). The API now lives at /api/{growth|growth_weekly|enterprise}/v2.
CRYPTOPANIC_TOKEN=
CRYPTOPANIC_API_URL=https://cryptopanic.com/api/growth/v2
# Ethos needs no key. Score X handles live (api.ethos.network). Default: true in live mode, false in test mode.
ETHOS_ENABLED=
# Value for the `X-Ethos-Client` header on Ethos API v2 calls.
ETHOS_CLIENT=ghosty@0.1.0
ETHOS_API_URL=https://api.ethos.network/api/v2
# xAI API key for Grok x_search (console.x.ai). Optional, paid per post fetched. Unset = off.
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Comma-separated X handles (no @, max 20) for allowed_x_handles. Empty = DeItaone,Reuters,WatcherGuru,tier10k,zerohedge.
XAI_X_HANDLES=
# Minimum seconds between paid x_search calls; polls in between reuse the cached result.
XAI_MIN_INTERVAL_SECONDS=300

# --- Safety and limits ------------------------------------------------------
# When true, /voice and /button return 503 brain_offline if 0G is unreachable (0G Physical AI requirement).
SAFE_STOP_ENABLED=true
# Force safe-stop to demo "brain offline". When OG_API_KEY is set, the server also pings the router (GET /models).
SIMULATE_BRAIN_OFFLINE=false
# Hard cap on total USD notional per decision across all legs.
MAX_TRADE_USD=25
# Seconds a presented alert can still be confirmed with the button; later presses answer 409 alert_expired.
PENDING_DECISION_TTL_SEC=120

# --- Terminal + market data (market/) -----------------------------------------
# Network for the terminal's read-only prices (no keys). Orders still follow HL_TESTNET.
MARKET_DATA_NETWORK=mainnet
# Watchlist; HIP-3 coins carry their dex prefix (trade.xyz lists the S&P 500 as xyz:SP500).
# Coins that do not exist on the network are reported as missing, not faked.
MARKET_WATCHLIST=BTC,ETH,SOL,xyz:GOLD,xyz:CL,xyz:TSLA,xyz:NVDA,xyz:SP500
# Built terminal served at /. Empty = ../terminal/dist (relative to server/).
TERMINAL_DIST=
# Origins allowed by CORS in live mode (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Claude (Anthropic API): researches and talks, never decides trades (0G does) ---
# Questions on /voice and /voice/text ("what's moving gold?") are answered by Claude; trade requests stay on 0G.
# The scout runs one web_search cycle every CLAUDE_SCOUT_MINUTES and feeds the news aggregator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Both default to true when ANTHROPIC_API_KEY is set.
CLAUDE_VOICE_ENABLED=
CLAUDE_SCOUT_ENABLED=
CLAUDE_SCOUT_MINUTES=5
CLAUDE_SCOUT_MAX_PER_DAY=200
# CLAUDE_SCOUT_QUERY=breaking geopolitical, regulatory, exchange-hack and macro news that could move BTC, ETH, gold, oil or US stocks in the last hour

# --- 0G timeouts for slow networks ---
# Safe-stop probe timeout; offline only after 2 consecutive failures, online again after 1 success.
OG_HEALTH_TIMEOUT_MS=15000
# Per-attempt decide() timeout; one retry on timeout or ECONNRESET only. Never a fake decision.
OG_DECIDE_TIMEOUT_MS=45000
