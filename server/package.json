{
  "name": "ghosty-server",
  "version": "0.1.0",
  "private": true,
  "description": "Ghosty brain: voice in, news + credibility + 0G decision loop, trade out.",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "pod": "tsx src/cli/pod.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "GHOSTY_MODE=test node --test --import tsx test/*.test.ts",
    "x402:demo": "tsx src/scripts/x402Demo.ts",
    "hedera:setup": "tsx src/scripts/hederaSetup.ts",
    "hedera:dabao-account": "tsx src/scripts/hederaDabaoAccount.ts",
    "signal-desk": "tsx src/scripts/signalDesk.ts",
    "hl:check": "tsx src/scripts/hlCheck.ts",
    "doctor": "tsx src/scripts/doctor.ts",
    "start:live": "npm run build && GHOSTY_MODE=live node dist/index.js"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.13",
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@fastify/static": "^10.1.10",
    "@hiero-ledger/sdk": "2.90.1",
    "@nktkas/hyperliquid": "^0.33.3",
    "@x402/core": "~2.30.0",
    "@x402/fetch": "~2.30.0",
    "@x402/hedera": "~2.30.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.1",
    "fastify": "^5.12.8",
    "openai": "^7.52.0",
    "pino-pretty": "^13.2.0",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
