# Copy to .env (same folder) and fill in. .env is gitignored.

# Claude: the brain.
ANTHROPIC_API_KEY=
# Claude model and effort. Sonnet 5.5 at medium effort by default.
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium

# Speech to text: Groq Whisper (free tier works). https://console.groq.com/keys
GROQ_API_KEY=
# Language you speak to the pod: en (default), hi, ... or auto to let Whisper guess (it often guesses wrong).
STT_LANGUAGE=en

# Text to speech: ElevenLabs is used when set, else OpenAI.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=

# Must match GHOSTY_DEVICE_TOKEN in the pod's secrets.h.
GHOSTY_DEVICE_TOKEN=

# The pod reaches this PC at http://<this PC's IP>:PORT
PORT=8787
