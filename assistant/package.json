{
  "name": "ghosty-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Ghosty as a plain personal assistant: pod voice in, Claude, voice out. No trading, no web3.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "ask": "tsx src/ask.ts",
    "play": "tsx src/play.ts",
    "stop": "tsx src/stop.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
