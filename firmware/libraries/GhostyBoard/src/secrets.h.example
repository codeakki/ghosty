// secrets.h.example - copy to secrets.h (same folder) and fill in.
// secrets.h is gitignored. Never commit real credentials.
//
//   cp firmware/libraries/GhostyBoard/src/secrets.h.example \
//      firmware/libraries/GhostyBoard/src/secrets.h
#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// Laptop running the Ghosty server on the same LAN (no trailing slash).
#define GHOSTY_SERVER_URL "http://192.168.1.10:3000"

// Shared secret sent as the X-Device-Token header. Must match the server .env.
#define GHOSTY_DEVICE_TOKEN "change-me"
